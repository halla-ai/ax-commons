{
  "name": "ax-commons",
  "version": "0.1.0",
  "private": true,
  "description": "Open contribution loop for public AI-adoption programs",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test test/*.test.mjs && npm run test --workspaces --if-present",
    "validate:skills": "node scripts/validate-skill.mjs commons/skills"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
