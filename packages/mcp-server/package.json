{
  "name": "@ax-commons/mcp-server",
  "version": "0.1.0",
  "description": "Local MCP server for the ax-commons contribution loop: on-device ledger, no conversation text, no network transmission",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.mjs",
  "bin": {
    "ax-commons": "./bin/ax-commons.mjs"
  },
  "files": [
    "dist",
    "bin",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --test test/*.test.ts",
    "start": "node dist/server.mjs",
    "pack": "npm run build && npx --yes @anthropic-ai/mcpb@2.1.2 pack . ax-commons.mcpb"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
